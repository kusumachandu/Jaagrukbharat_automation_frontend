# Base URL of the AutoFlow NestJS backend (include /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Shown on the public session page (the link a person opens to enter an OTP/CAPTCHA).
# Defaults to "Jaagruk Bharat". NEXT_PUBLIC_* values are baked in at build time — rebuild after changing.
NEXT_PUBLIC_BRAND_NAME=Jaagruk Bharat
# Your privacy policy page; leave empty to show no link.
NEXT_PUBLIC_PRIVACY_URL=
